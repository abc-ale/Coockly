<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="TemaCookly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/coral</item>
        <item name="colorSecondary">@color/verde</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/crema</item>
        <item name="android:statusBarColor">@color/crema</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Widget.Cookly.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/coral</item>
    </style>
</resources>
