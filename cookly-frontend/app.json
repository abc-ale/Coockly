{
  "expo": {
    "scheme": "cookly",
    "name": "Cookly",
    "slug": "cookly-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cooklyteam.cookly",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "package": "com.cooklyteam.cookly",
      "adaptiveIcon": {
        "backgroundColor": "#FF4D80",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-speech-recognition",
      "expo-web-browser",
      "expo-image",
      ["expo-splash-screen", { "image": "./assets/images/splash-icon.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#FF4D80" }],
      ["expo-notifications", { "color": "#FF4D80" }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18aa2e66-0e01-4804-8f39-5ecc9eafd873"
      }
    },
    "owner": "melllfer"
  }
}